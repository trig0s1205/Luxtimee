# --- Desarrollo local ---
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NUXT_PUBLIC_API_ASSETS_URL=http://localhost:3001
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Producción (Vercel) con Cloudflare delante ---
# NUXT_API_UPSTREAM_URL=https://TU-SERVICIO.run.app
# NUXT_PUBLIC_API_BASE_URL=/api/v1
# NUXT_PUBLIC_API_ASSETS_URL=
# NUXT_PUBLIC_SITE_URL=https://www.luxtimee.com

# --- API (Cloud Run) con proxy same-origin ---
# COOKIE_SAME_SITE=lax
# FRONTEND_URL=https://www.luxtimee.com
# Obligatorio en producción (Vercel). Si falta, /acceso/* responde 404.
# Debe coincidir con STAFF_LOGIN_SLUG de la API (Cloud Run).
# El default de apps/web/.env.defaults solo aplica fuera de producción.
NUXT_PUBLIC_STAFF_LOGIN_SLUG=dev-portal-lx9k2
# Sitemap en el servidor de Nuxt. NUXT_API_INTERNAL_URL debe ser la base absoluta
# alcanzable desde Vercel e incluir /api/v1 (ejemplo: https://TU-SERVICIO.run.app/api/v1).
# Si solo existe NUXT_API_UPSTREAM_URL (origen sin ruta), el sitemap le agrega /api/v1.
# NUXT_SITEMAP_MOCK_FALLBACK=0 impide el catálogo de respaldo cuando la API falla.
# Google Analytics 4 (cliente — Vercel)
NUXT_PUBLIC_GA4_MEASUREMENT_ID=
# Google Search Console — meta tag de verificación (Vercel)
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
