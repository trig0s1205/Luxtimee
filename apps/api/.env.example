NODE_ENV=development
USE_MOCKS=true
PORT=3001
FRONTEND_URL=http://localhost:3000
# Obligatorio en producción. Si falta, el callback de Google no redirige al slug público de desarrollo.
STAFF_LOGIN_SLUG=dev-portal-lx9k2

# Local: postgresql://luxtime:TU_PASSWORD@127.0.0.1:5432/luxtime
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
# Si se omite, la API usa JWT_SECRET. En Cloud Run define un secreto distinto.
JWT_REFRESH_SECRET=
# Duración del access. Con unidad: 15m, 1h. Un número pelado son segundos (900 = 15 min), no ms.
# El mismo valor, recortado, firma y verifica. Un salto de línea en Secret Manager no rompe la firma.
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=90d
# Producción con proxy /api/v1 en www.luxtimee.com:
# COOKIE_SAME_SITE=lax
# Mismo valor que NUXT_CLIENT_IP_SECRET en Vercel. Sin esto, req.ip es el peer
# del balanceador (la salida de Vercel), no el visitante. trust proxy se queda en 1.
# CLIENT_IP_SECRET=
CRON_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=luxtime/watches
IMAGE_SERVICE_URL=http://localhost:8001
IMAGE_SERVICE_API_KEY=
REMBG_MODEL=u2netp
SEED_ADMIN_PASSWORD=
# Correo al cliente. Sin EMAIL_FROM y sin SMTP_HOST/RESEND_API_KEY no se envía nada.
# USE_MOCKS=true también deja el envío en no-op. Precedencia: SMTP_HOST, luego Resend.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
SENTRY_DSN=
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
