# Entorno de ejecución (development | production)
NODE_ENV=development
# true = mocks de correo, WhatsApp, Cloudinary, GA4, etc. En producción: false
USE_MOCKS=true
# Puerto HTTP de la API (Render y Docker inyectan PORT; local suele ser 3001)
PORT=3001
# Interfaz de escucha (0.0.0.0 = todas; no hace falta cambiarlo en contenedor)
HOST=0.0.0.0
# Orígenes del front permitidos en CORS (coma si hay varios). Ej: https://www.luxtimee.com
FRONTEND_URL=http://localhost:3000
# Slug público del login staff. Debe coincidir con NUXT_PUBLIC_STAFF_LOGIN_SLUG en la web
STAFF_LOGIN_SLUG=dev-portal-lx9k2

# Postgres (pooler o URL de app). Ejemplo: postgresql://USER:PASSWORD@HOST:5432/DB?pgbouncer=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
# Conexión directa (migraciones/pg_dump). Misma forma, sin transaction pooler
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# Secreto de firma JWT (access). Obligatorio
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# Secreto del refresh token. En producción conviene distinto de JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET
# Duración del access (15m, 1h; número pelado = segundos)
JWT_ACCESS_EXPIRES=15m
# Duración del refresh
JWT_REFRESH_EXPIRES=90d
# SameSite de cookies de sesión (lax con proxy same-origin en www)
COOKIE_SAME_SITE=lax
# Mismo valor que NUXT_CLIENT_IP_SECRET en Vercel; firma la IP del visitante
CLIENT_IP_SECRET=CHANGE_ME_PROXY_IP_SECRET
# Header x-cron-secret / Bearer para jobs internos /api/v1/internal/cron
CRON_SECRET=CHANGE_ME_CRON_SECRET

# OAuth Google (login staff)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Cloudinary (imágenes de relojes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=luxtime/watches

# Solo seeds locales; no usar en producción
SEED_ADMIN_PASSWORD=

# Correo al cliente. Sin EMAIL_FROM + (SMTP_HOST o RESEND_API_KEY) no se envía
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=

# WhatsApp Cloud API (notificaciones staff; opcional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Observabilidad (opcional; si no hay integración activa se ignora)
SENTRY_DSN=

# Google Analytics 4 Data API (panel admin)
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
# Clave privada PEM; en paneles usa \n escapados en una sola línea
GA4_PRIVATE_KEY=
