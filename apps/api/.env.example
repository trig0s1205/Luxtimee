NODE_ENV=development
USE_MOCKS=true
PORT=3001
FRONTEND_URL=http://localhost:3000
STAFF_LOGIN_SLUG=dev-portal-lx9k2

# Local: postgresql://luxtime:TU_PASSWORD@127.0.0.1:5432/luxtime
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=90d
# Producción con proxy /api/v1 en luxtimee.com:
# COOKIE_SAME_SITE=lax
CRON_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=luxtime/watches
IMAGE_SERVICE_URL=http://localhost:8001
IMAGE_SERVICE_API_KEY=
REMBG_MODEL=u2netp
SEED_ADMIN_PASSWORD=
# Correo al cliente. Sin EMAIL_FROM y sin SMTP_HOST/RESEND_API_KEY no se envía nada.
# USE_MOCKS=true también deja el envío en no-op. Precedencia: SMTP_HOST, luego Resend.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
SENTRY_DSN=
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
