# Luxtime — referencia de variables (sin secretos reales)
# Copia a apps/api/.env y apps/web/.env según corresponda

# General
NODE_ENV=development
USE_MOCKS=true

# API
PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
STAFF_LOGIN_SLUG=dev-portal-lx9k2
# Local: docker compose + apps/api/.env
# Producción: Secret Manager → Cloud Run (API)

# Auth (solo Cloud Run / .env local API — nunca NUXT_PUBLIC_*)
JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=90d
CRON_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Cloudinary (solo Cloud Run / .env local API)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=luxtime/watches

# Image microservice
IMAGE_SERVICE_URL=http://localhost:8001
IMAGE_SERVICE_API_KEY=
IMAGE_SERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
REMBG_MODEL=u2netp

# Seed manual (solo local/CI — nunca producción)
SEED_ADMIN_PASSWORD=

# Integraciones (solo Cloud Run)
RESEND_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
SENTRY_DSN=
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Web (Vercel) — solo URLs públicas
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NUXT_PUBLIC_API_ASSETS_URL=http://localhost:3001
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_GA4_MEASUREMENT_ID=
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Docker local
POSTGRES_PASSWORD=
