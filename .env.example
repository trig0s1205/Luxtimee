# Luxtime — referencia de variables (sin secretos reales)
# Copia a apps/api/.env y apps/web/.env según corresponda

# General
NODE_ENV=development
USE_MOCKS=true

# API
PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
# En producción (Cloud Run y Vercel) es obligatorio. Si falta, el login staff responde 404.
# El valor de desarrollo dev-portal-lx9k2 no se usa como respaldo en producción.
STAFF_LOGIN_SLUG=dev-portal-lx9k2
# Local: docker compose + apps/api/.env
# Producción: Secret Manager → Cloud Run (API)

# Auth (solo Cloud Run / .env local API — nunca NUXT_PUBLIC_*)
JWT_SECRET=
# Secreto distinto de JWT_SECRET. Si se omite, la API usa JWT_SECRET.
# En Cloud Run hay que definir un valor propio.
JWT_REFRESH_SECRET=
# 15m, o segundos si es un número pelado (900). No uses milisegundos.
# Mismo valor en Cloud Run (CLIENT_IP_SECRET) y Vercel (NUXT_CLIENT_IP_SECRET).
CLIENT_IP_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=90d
CRON_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Cloudinary (solo Cloud Run / .env local API)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=luxtime/watches

# Image microservice
IMAGE_SERVICE_URL=http://localhost:8001
IMAGE_SERVICE_API_KEY=
IMAGE_SERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
REMBG_MODEL=u2netp

# Seed manual (solo local/CI — nunca producción)
SEED_ADMIN_PASSWORD=

# Integraciones (solo Cloud Run)
# Correo al cliente (pre-pedido creado, abono confirmado, suspendido, cancelado, enviado).
# Si USE_MOCKS=true, o si faltan EMAIL_FROM y un proveedor, el envío no hace nada.
# Precedencia: SMTP_HOST si está definido; si no, Resend (RESEND_API_KEY).
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
SENTRY_DSN=
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Web (Vercel) — solo URLs públicas
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NUXT_PUBLIC_API_ASSETS_URL=http://localhost:3001
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Producción (Vercel): NUXT_PUBLIC_SITE_URL=https://www.luxtimee.com
# NUXT_API_INTERNAL_URL=https://TU-API.run.app/api/v1
# NUXT_PUBLIC_STAFF_LOGIN_SLUG debe coincidir con STAFF_LOGIN_SLUG
NUXT_PUBLIC_GA4_MEASUREMENT_ID=
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Vacías = no se publican en el JSON-LD. Solo datos reales.
# NUXT_PUBLIC_BUSINESS_PHONE=
# NUXT_PUBLIC_BUSINESS_WHATSAPP=
# NUXT_PUBLIC_BUSINESS_OPENING_HOURS=
# NUXT_PUBLIC_BUSINESS_SAME_AS=

# Docker local
POSTGRES_PASSWORD=
