# Luxtime — variables de entorno (raíz / referencia)
# Copia a apps/api/.env y apps/web/.env según corresponda

# General
NODE_ENV=development
USE_MOCKS=true

# API
PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://luxtime:luxtime_dev@localhost:5432/luxtime?schema=public

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CRON_SECRET=change-me-cron-secret-in-production
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=luxtime/watches

# Image microservice
IMAGE_SERVICE_URL=http://localhost:8001
IMAGE_SERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Resend
RESEND_API_KEY=

# WhatsApp Business Platform (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Sentry
SENTRY_DSN=

# Google Analytics 4
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Web (Nuxt)
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NUXT_PUBLIC_SITE_URL=http://localhost:3000
