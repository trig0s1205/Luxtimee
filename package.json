{
  "name": "luxtime",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @luxtime/web dev",
    "dev:api": "pnpm --filter @luxtime/api start:dev",
    "dev:lan": "node scripts/dev-lan.mjs",
    "dev:tunnel": "node scripts/dev-tunnel.mjs",
    "firewall:lan": "powershell -ExecutionPolicy Bypass -File scripts/open-firewall.ps1",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @luxtime/shared build && pnpm -r typecheck",
    "db:migrate": "pnpm --filter @luxtime/api prisma:migrate",
    "db:seed": "pnpm --filter @luxtime/api prisma:seed",
    "prisma:studio": "pnpm --filter @luxtime/api prisma:studio"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
