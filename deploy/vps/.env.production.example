# =============================================================================
# Plantilla de producción para ~/luxtimee/.env en el VPS.
# Cópiala con: bash ./set-env.sh  (NO pegues secretos reales en el repo).
# Sin comillas. Sin espacios alrededor de =. Evita el carácter $ en valores
# (Docker Compose lo interpreta); en contraseñas de DB usa URL-encoding (%24).
# =============================================================================

# --- Fijos de la API (no secretos) ---
# Obligatorio. Debe ser production.
NODE_ENV=production
# Obligatorio. Nunca true en el VPS (devolvería URLs falsas de Cloudinary).
USE_MOCKS=false
# Obligatorio. Puerto interno del contenedor.
PORT=3000
# Obligatorio. Escucha en todas las interfaces del contenedor.
HOST=0.0.0.0
# Obligatorio. Orígenes CORS del front (coma si hay varios). Debe incluir el sitio en Vercel.
FRONTEND_URL=https://www.luxtimee.com
# Obligatorio. Debe coincidir con NUXT_PUBLIC_STAFF_LOGIN_SLUG en Vercel.
STAFF_LOGIN_SLUG=dev-portal-lx9k2
# Obligatorio. SameSite de cookies (proxy same-origin vía Vercel).
COOKIE_SAME_SITE=lax
# Obligatorio. Duración del access token.
JWT_ACCESS_EXPIRES=15m
# Obligatorio. Duración del refresh token.
JWT_REFRESH_EXPIRES=90d
# Obligatorio. Carpeta Cloudinary. CONFIRMAR con Daniel el valor real de producción
# (código tiene defaults mezclados: luxtime/watches vs LUXTIMEE/watches).
CLOUDINARY_FOLDER=luxtime/watches
# Obligatorio. Heap de Node. Validado en local: 1024 MB (videos hasta 120 MB en memoria).
NODE_OPTIONS=--max-old-space-size=1024

# --- Despliegue (solo compose / Caddy; la API no las lee) ---
# Obligatorio. Dominio público de la API (sin https://).
API_DOMAIN=api.luxtimee.com
# Obligatorio. Correo para Let's Encrypt (Caddy).
ACME_EMAIL=CAMBIAR_correo@ejemplo.com
# Obligatorio. Imagen con tag fijo sha-… (no uses latest en el sábado).
# Ejemplo: ghcr.io/trig0s1205/luxtimee-api:sha-<sha-completo>
API_IMAGE=ghcr.io/trig0s1205/luxtimee-api:sha-CAMBIAR

# --- Base de datos Supabase ---
# Obligatorio. Pooler de TRANSACCIONES (puerto típico 6543) + ?pgbouncer=true
# Origen: Supabase → Project Settings → Database → Connection string (Transaction).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Obligatorio. Conexión DIRECTA o Session pooler (puerto 5432), SIN pgbouncer=true.
# Origen: misma pantalla, modo Direct o Session. Usada por migraciones y pg_dump.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Secretos JWT / anti-abuso / cron ---
# Obligatorio ≥32 caracteres. Generar con set-env.sh o openssl rand -hex 48.
JWT_SECRET=CAMBIAR_jwt_access_largo
# Obligatorio. Distinto de JWT_SECRET.
JWT_REFRESH_SECRET=CAMBIAR_jwt_refresh_largo
# Obligatorio. DEBE ser idéntico a NUXT_CLIENT_IP_SECRET en Vercel.
CLIENT_IP_SECRET=CAMBIAR_mismo_que_vercel
# Obligatorio. Header x-cron-secret / Bearer de jobs internos.
CRON_SECRET=CAMBIAR_cron_secreto

# --- Google OAuth (login staff) ---
# Obligatorio si se usa login con Google.
GOOGLE_OAUTH_CLIENT_ID=CAMBIAR
GOOGLE_OAUTH_CLIENT_SECRET=CAMBIAR
# Obligatorio. Callback de la API pública.
GOOGLE_OAUTH_CALLBACK_URL=https://api.luxtimee.com/api/v1/auth/google/callback

# --- Cloudinary (fotos/videos de relojes) ---
# Obligatorios en producción (USE_MOCKS=false).
CLOUDINARY_CLOUD_NAME=CAMBIAR
CLOUDINARY_API_KEY=CAMBIAR
CLOUDINARY_API_SECRET=CAMBIAR

# --- Microservicio de imágenes (NO se despliega el sábado) ---
# Dejar vacíos. El PR #30 elimina el uso; sin él la API intenta y marca imageNeedsReview.
IMAGE_SERVICE_URL=
IMAGE_SERVICE_API_KEY=
REMBG_MODEL=

# --- Correo al cliente (opcional si no se envían mails) ---
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=

# --- WhatsApp Cloud API (opcional) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- Observabilidad (opcional) ---
SENTRY_DSN=

# --- Google Analytics 4 Data API (panel admin; opcional) ---
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
# Una sola línea con \n literales (no saltos reales). Evita el carácter $ sin codificar.
GA4_PRIVATE_KEY=

# =============================================================================
# NO USAR en producción
# SEED_ADMIN_PASSWORD=   (solo seeds locales)
# USE_MOCKS=true         (URLs falsas de Cloudinary)
# IMAGE_SERVICE_*        (sin contenedor rembg el sábado)
# =============================================================================
